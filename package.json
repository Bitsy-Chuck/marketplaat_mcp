{
  "name": "marktplaats-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for marktplaats.nl: search listings, specs, price, delivery",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "test": "npm run test:client && npm run test:mcp",
    "test:client": "node scripts/verify.mjs",
    "test:mcp": "node scripts/smoke-mcp.mjs",
    "capture": "node scripts/capture.mjs",
    "ask": "node scripts/ask.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "marktplaats",
    "classifieds",
    "netherlands"
  ],
  "author": "Bitsy-Chuck",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitsy-Chuck/marketplaat_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Bitsy-Chuck/marketplaat_mcp/issues"
  },
  "homepage": "https://github.com/Bitsy-Chuck/marketplaat_mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.4.3"
  },
  "bin": {
    "marktplaats-mcp": "dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
